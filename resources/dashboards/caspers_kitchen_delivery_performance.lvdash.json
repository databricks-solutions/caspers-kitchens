{
  "datasets": [
    {
      "name": "delivery_times",
      "displayName": "Delivery Times",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  ai.order_delivery_times_per_location_view"
      ]
    },
    {
      "name": "order_kpis",
      "displayName": "Order KPIs",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  lakeflow.gold_order_header"
      ]
    },
    {
      "name": "orders_by_location",
      "displayName": "Orders by Location",
      "queryLines": [
        "SELECT\n",
        "  o.order_id,\n",
        "  o.location_id,\n",
        "  l.name AS location_name,\n",
        "  o.order_day,\n",
        "  o.order_revenue,\n",
        "  o.total_qty,\n",
        "  o.total_items\n",
        "FROM\n",
        "  lakeflow.gold_order_header o\n",
        "    JOIN simulator.locations l\n",
        "      ON o.location_id = CAST(l.location_id AS STRING)"
      ]
    }
  ],
  "pages": [
