{
  "datasets": [
    {
      "name": "healthy_options",
      "displayName": "Healthy Options",
      "queryLines": [
        "SELECT\n",
        "  item_name,\n",
        "  brand_name,\n",
        "  cuisine,\n",
        "  category,\n",
        "  price,\n",
        "  calories,\n",
        "  protein_g,\n",
        "  fat_g,\n",
        "  carbs_g,\n",
        "  protein_pct\n",
        "FROM\n",
        "  menu_documents.silver_menu_items\n",
        "WHERE\n",
        "  is_high_protein = true\n",
        "  AND is_low_calorie = true\n",
        "ORDER BY\n",
        "  protein_pct DESC"
      ]
    },
    {
      "name": "menu_items_metrics",
      "displayName": "Menu Items Metrics",
      "config": {
        "version": 1.1,
        "source": "menu_documents.silver_menu_items",
        "dimensions": [
          {
            "name": "brand_name",
            "expr": "brand_name",
            "displayName": "Brand"
          },
          {
            "name": "cuisine",
            "expr": "cuisine",
            "displayName": "Cuisine"
          },
          {
            "name": "category",
            "expr": "category",
            "displayName": "Category"
          },
          {
            "name": "price_tier",
            "expr": "price_tier",
            "displayName": "Price Tier"
          },
          {
            "name": "calorie_category",
            "expr": "calorie_category",
            "displayName": "Calorie Category"
          },
          {
            "name": "item_name",
            "expr": "item_name",
            "displayName": "Item Name"
          },
          {
            "name": "price",
            "expr": "price",
            "displayName": "Price"
          },
          {
            "name": "calories",
            "expr": "calories",
            "displayName": "Calories"
          },
          {
            "name": "protein_g",
            "expr": "protein_g",
            "displayName": "Protein (g)"
          },
          {
            "name": "is_high_protein",
            "expr": "is_high_protein",
            "displayName": "High Protein"
          },
          {
            "name": "is_low_calorie",
            "expr": "is_low_calorie",
            "displayName": "Low Calorie"
          },
          {
            "name": "is_allergen_free",
            "expr": "is_allergen_free",
            "displayName": "Allergen Free"
          }
        ],
        "measures": [
          {
            "name": "total_items",
            "expr": "COUNT(*)",
            "displayName": "Total Menu Items"
          },
          {
            "name": "avg_price",
            "expr": "AVG(price)",
            "displayName": "Avg Price",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "avg_calories",
            "expr": "AVG(calories)",
            "displayName": "Avg Calories",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "allergen_free_count",
            "expr": "COUNT(CASE WHEN is_allergen_free = true THEN 1 END)",
            "displayName": "Allergen-Free Items"
          },
          {
            "name": "pct_allergen_free",
            "expr": "MEASURE(allergen_free_count) * 100.0 / MEASURE(total_items)",
            "displayName": "% Allergen Free",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          }
        ]
      }
    },
    {
      "name": "allergen_prevalence",
      "displayName": "Allergen Prevalence",
      "queryLines": [
        "SELECT\n",
        "  allergen_type,\n",
        "  COUNT(*) as item_count\n",
        "FROM\n",
        "  menu_documents.allergens\n",
        "    UNPIVOT (\n",
        "      contains_allergen FOR allergen_type IN (\n",
        "        contains_wheat AS Wheat,\n",
        "        contains_milk AS Milk,\n",
        "        contains_egg AS Egg,\n",
        "        contains_soy AS Soy,\n",
        "        contains_peanut AS Peanut,\n",
        "        contains_tree_nut AS Tree_Nut,\n",
        "        contains_fish AS Fish,\n",
        "        contains_shellfish AS Shellfish,\n",
        "        contains_sesame AS Sesame\n",
        "      )\n",
        "    )\n",
        "WHERE\n",
        "  contains_allergen = true\n",
        "GROUP BY\n",
        "  allergen_type\n",
        "ORDER BY\n",
        "  item_count DESC"
      ]
    }
  ],
