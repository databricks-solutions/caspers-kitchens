{
  "datasets": [
    {
      "name": "agent_requests",
      "displayName": "Agent Requests",
      "queryLines": [
        "SELECT\n",
        "  databricks_request_id,\n",
        "  request_date,\n",
        "  request_time,\n",
        "  status_code,\n",
        "  execution_duration_ms\n",
        "FROM\n",
        "  ai.complaint_agent_payload"
      ],
      "columns": [
        {
          "displayName": "Successful Requests",
          "expression": "SUM(CASE WHEN `status_code` = 200 THEN 1 ELSE 0 END)"
        }
      ]
    },
    {
      "name": "agent_decisions",
      "displayName": "Agent Decisions",
      "queryLines": [
        "SELECT\n",
        "  databricks_request_id,\n",
        "  request_date,\n",
        "  request_time,\n",
        "  status_code,\n",
        "  execution_duration_ms,\n",
        "  get_json_object(\n",
        "    get_json_object(response, '$.output[0].content[0].text'),\n",
        "    '$.complaint_category'\n",
        "  ) AS complaint_category,\n",
        "  get_json_object(\n",
        "    get_json_object(response, '$.output[0].content[0].text'),\n",
        "    '$.decision'\n",
        "  ) AS decision,\n",
        "  CAST(\n",
        "    get_json_object(\n",
        "      get_json_object(response, '$.output[0].content[0].text'),\n",
        "      '$.credit_amount'\n",
        "    ) AS DOUBLE\n",
        "  ) AS credit_amount,\n",
        "  get_json_object(\n",
        "    get_json_object(response, '$.output[0].content[0].text'),\n",
        "    '$.confidence'\n",
        "  ) AS confidence,\n",
        "  get_json_object(\n",
        "    get_json_object(response, '$.output[0].content[0].text'),\n",
        "    '$.priority'\n",
        "  ) AS priority\n",
        "FROM\n",
        "  ai.complaint_agent_payload\n",
        "WHERE\n",
        "  status_code = 200"
      ],
      "columns": [
        {
          "displayName": "Escalation Rate",
          "expression": "SUM(CASE WHEN `decision` = 'escalate' THEN 1 ELSE 0 END) * 1.0 / COUNT(`databricks_request_id`)"
        }
      ]
    }
  ],
